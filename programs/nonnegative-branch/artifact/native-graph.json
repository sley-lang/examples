  "recipe_json": "{\n  \"contract\": \"sley-tools.graph-authoring.v0\",\n  \"program_id\": \"nonnegative-branch\",\n  \"title\": \"Nonnegative Branch\",\n  \"purpose\": \"Decide nonnegativity with an explicit two-way native branch on the sign test\",\n  \"parameters\": [{\"name\": \"value\", \"value_type\": \"SInt64\"}],\n  \"constants\": [\n    {\"name\": \"zero\", \"value_type\": \"SInt64\", \"value\": \"0\"},\n    {\"name\": \"yes\", \"value_type\": \"Bool\", \"value\": true},\n    {\"name\": \"no\", \"value_type\": \"Bool\", \"value\": false}\n  ],\n  \"result\": {\"kind\": \"primitive\", \"value_type\": \"Bool\"},\n  \"entry_block\": \"entry\",\n  \"blocks\": [\n    {\n      \"name\": \"entry\",\n      \"operations\": [\n        {\"op\": \"constant_ref\", \"name\": \"origin\", \"constant\": \"zero\"},\n        {\"op\": \"less_than\", \"name\": \"is_negative\", \"left\": \"param.value\", \"right\": \"op.origin\"}\n      ],\n      \"terminator\": {\"kind\": \"cond_branch\", \"condition\": \"op.is_negative\", \"if_true\": \"negative\", \"if_false\": \"nonnegative\"}\n    },\n    {\n      \"name\": \"negative\",\n      \"operations\": [\n        {\"op\": \"constant_ref\", \"name\": \"neg_out\", \"constant\": \"no\"}\n      ],\n      \"terminator\": {\"kind\": \"return\", \"value\": \"op.neg_out\"}\n    },\n    {\n      \"name\": \"nonnegative\",\n      \"operations\": [\n        {\"op\": \"constant_ref\", \"name\": \"pos_out\", \"constant\": \"yes\"}\n      ],\n      \"terminator\": {\"kind\": \"return\", \"value\": \"op.pos_out\"}\n    }\n  ]\n}\n",
