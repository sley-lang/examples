  "recipe_json": "{\n  \"contract\": \"sley-tools.graph-authoring.v0\",\n  \"program_id\": \"bool-status\",\n  \"title\": \"Boolean Status\",\n  \"purpose\": \"Report conjunction, disjunction, and joint negation of two Boolean inputs in one record\",\n  \"parameters\": [\n    {\"name\": \"a\", \"value_type\": \"Bool\"},\n    {\"name\": \"b\", \"value_type\": \"Bool\"}\n  ],\n  \"constants\": [],\n  \"result\": {\"kind\": \"record\", \"fields\": [\n    {\"name\": \"both\", \"value_type\": \"Bool\"},\n    {\"name\": \"either\", \"value_type\": \"Bool\"},\n    {\"name\": \"neither\", \"value_type\": \"Bool\"}\n  ]},\n  \"entry_block\": \"entry\",\n  \"blocks\": [{\n    \"name\": \"entry\",\n    \"operations\": [\n      {\"op\": \"bool_and\", \"name\": \"both\", \"left\": \"param.a\", \"right\": \"param.b\"},\n      {\"op\": \"bool_or\", \"name\": \"either\", \"left\": \"param.a\", \"right\": \"param.b\"},\n      {\"op\": \"bool_not\", \"name\": \"neither\", \"operand\": \"op.either\"},\n      {\"op\": \"record_new\", \"name\": \"result\", \"fields\": [\"op.both\", \"op.either\", \"op.neither\"]}\n    ],\n    \"terminator\": {\"kind\": \"return\", \"value\": \"op.result\"}\n  }]\n}\n",
