{
  "contract": "sley-tools.graph-authoring.v0",
  "program_id": "bool-nor",
  "title": "Boolean Nor",
  "purpose": "Negate the disjunction of two Boolean inputs with native bool_or and bool_not",
  "parameters": [
    {"name": "a", "value_type": "Bool"},
    {"name": "b", "value_type": "Bool"}
  ],
  "constants": [],
