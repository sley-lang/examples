{
  "contract": "sley-tools.graph-authoring.v0",
  "program_id": "at-or-below",
  "title": "At Or Below Zero",
  "purpose": "Decide whether a signed value is at or below zero with native less_equal",
  "parameters": [{"name": "value", "value_type": "SInt64"}],
  "constants": [{"name": "zero", "value_type": "SInt64", "value": "0"}],
  "result": {"kind": "primitive", "value_type": "Bool"},
  "entry_block": "entry",
  "blocks": [{
    "name": "entry",
    "operations": [
      {"op": "constant_ref", "name": "origin", "constant": "zero"},
      {"op": "less_equal", "name": "bounded", "left": "param.value", "right": "op.origin"}
    ],
    "terminator": {"kind": "return", "value": "op.bounded"}
  }]
}
