{
  "contract": "sley-tools.graph-authoring.v0",
  "program_id": "uint32-cap",
  "title": "UInt32 Cap",
  "purpose": "Decide whether an unsigned count stays within a configured cap of 100",
  "parameters": [{"name": "count", "value_type": "UInt32"}],
  "constants": [{"name": "cap", "value_type": "UInt32", "value": "100"}],
  "result": {"kind": "primitive", "value_type": "Bool"},
  "entry_block": "entry",
  "blocks": [{
    "name": "entry",
    "operations": [
      {"op": "constant_ref", "name": "limit", "constant": "cap"},
      {"op": "less_equal", "name": "within", "left": "param.count", "right": "op.limit"}
    ],
    "terminator": {"kind": "return", "value": "op.within"}
  }]
}
