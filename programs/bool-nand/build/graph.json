{
  "contract": "sley-tools.graph-authoring.v0",
  "program_id": "bool-nand",
  "title": "Boolean Nand",
  "purpose": "Negate the conjunction of two Boolean inputs with native bool_and and bool_not",
  "parameters": [
    {"name": "a", "value_type": "Bool"},
    {"name": "b", "value_type": "Bool"}
  ],
  "constants": [],
  "result": {"kind": "primitive", "value_type": "Bool"},
  "entry_block": "entry",
  "blocks": [{
    "name": "entry",
    "operations": [
      {"op": "bool_and", "name": "both", "left": "param.a", "right": "param.b"},
      {"op": "bool_not", "name": "nand", "operand": "op.both"}
