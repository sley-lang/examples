{
  "contract": "sley-tools.graph-authoring.v0",
  "program_id": "is-positive",
  "title": "Is Positive",
  "purpose": "Decide whether a signed value is above zero with native greater_than",
  "parameters": [{"name": "value", "value_type": "SInt64"}],
  "constants": [{"name": "zero", "value_type": "SInt64", "value": "0"}],
  "result": {"kind": "primitive", "value_type": "Bool"},
  "entry_block": "entry",
  "blocks": [{
    "name": "entry",
    "operations": [
      {"op": "constant_ref", "name": "origin", "constant": "zero"},
      {"op": "greater_than", "name": "positive", "left": "param.value", "right": "op.origin"}
    ],
    "terminator": {"kind": "return", "value": "op.positive"}
  }]
}
