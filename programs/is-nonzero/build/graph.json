{
  "contract": "sley-tools.graph-authoring.v0",
  "program_id": "is-nonzero",
  "title": "Is Nonzero",
  "purpose": "Decide whether a signed value differs from zero with native not_equal",
  "parameters": [{"name": "value", "value_type": "SInt64"}],
  "constants": [{"name": "zero", "value_type": "SInt64", "value": "0"}],
  "result": {"kind": "primitive", "value_type": "Bool"},
  "entry_block": "entry",
  "blocks": [{
    "name": "entry",
    "operations": [
      {"op": "constant_ref", "name": "origin", "constant": "zero"},
      {"op": "not_equal", "name": "nonzero", "left": "param.value", "right": "op.origin"}
    ],
    "terminator": {"kind": "return", "value": "op.nonzero"}
  }]
}
