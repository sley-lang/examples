{
  "contract": "sley-tools.graph-authoring.v0",
  "program_id": "safe-sub",
  "title": "Safe Sub",
  "purpose": "Subtract two signed values with native checked arithmetic and report overflow",
  "parameters": [
    {"name": "a", "value_type": "SInt64"},
    {"name": "b", "value_type": "SInt64"}
  ],
  "constants": [],
  "result": {"kind": "record", "fields": [
    {"name": "difference", "value_type": "CheckedSInt64"}
  ]},
  "entry_block": "entry",
  "blocks": [{
    "name": "entry",
    "operations": [
      {"op": "int_sub_checked", "name": "diff", "left": "param.a", "right": "param.b"},
      {"op": "record_new", "name": "result", "fields": ["op.diff"]}
    ],
    "terminator": {"kind": "return", "value": "op.result"}
  }]
}
