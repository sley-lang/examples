{
 "af1": 1,
 "afx": 1,
 "test_tables": [
  {
   "name": "overlap_cases",
   "fn": "window_overlap",
   "cases": [
    {
     "args": [
      0,
      10,
      5,
      15
     ],
     "expect": {
      "Ok": [
       5,
       0
      ]
     }
    },
    {
     "args": [
      5,
      15,
      0,
      10
     ],
     "expect": {
      "Ok": [
       5,
       0
      ]
     }
    },
    {
     "args": [
      0,
      10,
      0,
      10
     ],
     "expect": {
      "Ok": [
       10,
       0
      ]
     }
    },
    {
     "args": [
      0,
      30,
      10,
      20
     ],
     "expect": {
      "Ok": [
       10,
       0
      ]
     }
    },
    {
     "args": [
      0,
      10,
      20,
      30
     ],
     "expect": {
      "Ok": [
       0,
       10
      ]
     }
    },
    {
     "args": [
      0,
      10,
      10,
      20
     ],
     "expect": {
      "Ok": [
       0,
       0
      ]
     }
    },
    {
     "args": [
      0,
      0,
      5,
      5
     ],
     "expect": {
      "Ok": [
       0,
       5
      ]
     }
    },
    {
     "args": [
      10,
      0,
      0,
      5
     ],
     "expect": {
      "Err": "BadFirst"
     }
    },
    {
     "args": [
      0,
      5,
      10,
      3
     ],
     "expect": {
      "Err": "BadSecond"
     }
    },
    {
     "args": [
      5,
      0,
      9,
      2
     ],
     "expect": {
      "Err": "BadFirst"
     }
    },
    {
     "args": [
      -9223372036854775808,
      9223372036854775807,
      -9223372036854775808,
      9223372036854775807
     ],
     "expect": {
      "Err": "Overflow"
     }
    },
    {
     "args": [
      9223372036854775807,
      9223372036854775807,
      -1,
      -1
     ],
     "expect": {
      "Err": "Overflow"
     }
    },
    {
     "args": [
      5,
      5,
      5,
      5
     ],
     "expect": {
      "Ok": [
       0,
       0
      ]
     }
    },
    {
     "args": [
      -30,
      -10,
      -20,
      -5
     ],
     "expect": {
      "Ok": [
       10,
       0
      ]
     }
    },
    {
     "args": [
      7,
      7,
      0,
      10
     ],
     "expect": {
      "Ok": [
       0,
       0
      ]
     }
    }
   ]
  }
 ]
}