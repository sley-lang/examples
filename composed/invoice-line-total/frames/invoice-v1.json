{"af1": 1, "afx": 1,
 "types": [{"name": "InvoiceError", "variant": ["BadQty", "BadPrice", "BadFee", "Overflow"]}],
 "fns": [{"fn": "line_total", "params": [["qty", "i64"], ["unit_cents", "i64"], ["fee_cents", "i64"]],
          "returns": "Result<i64,InvoiceError>",
          "blocks": [{"name": "entry",
            "ops": [["!BadQty", "if", ["lt", "qty", 1]],
