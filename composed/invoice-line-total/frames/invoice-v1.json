                    ["sub", "mul?Overflow", "qty", "unit_cents"],
                    ["total", "add?Overflow", "sub", "fee_cents"]],
            "term": ["ok", "total"]}]}],
 "test_tables": [{"name": "invoice_cases", "fn": "line_total", "cases": [
