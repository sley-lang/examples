{
 "af1": 1,
 "afx": 1,
 "test_tables": [
  {
   "name": "page_cases",
   "fn": "page_window",
   "cases": [
    {
     "args": [
      100,
      0,
      10
     ],
     "expect": {
      "Ok": [
       0,
       10,
       true
      ]
     }
    },
    {
     "args": [
      100,
      9,
      10
     ],
     "expect": {
      "Ok": [
       90,
       10,
       false
      ]
     }
    },
    {
     "args": [
      95,
      9,
      10
     ],
     "expect": {
      "Ok": [
       90,
       5,
       false
      ]
     }
    },
    {
     "args": [
      100,
      10,
      10
     ],
     "expect": {
      "Ok": [
       100,
       0,
       false
      ]
     }
    },
    {
     "args": [
      100,
      11,
      10
     ],
     "expect": {
      "Ok": [
       100,
       0,
       false
      ]
     }
    },
    {
     "args": [
      0,
      0,
      10
     ],
     "expect": {
      "Ok": [
       0,
       0,
       false
      ]
     }
    },
    {
     "args": [
      0,
      5,
      10
     ],
     "expect": {
      "Ok": [
       0,
       0,
       false
      ]
     }
    },
    {
     "args": [
      7,
      0,
      10
     ],
     "expect": {
      "Ok": [
       0,
       7,
       false
      ]
     }
    },
    {
     "args": [
      -1,
      0,
      10
     ],
     "expect": {
      "Err": "NegativeTotal"
     }
    },
    {
     "args": [
      100,
      -1,
      10
     ],
     "expect": {
      "Err": "NegativePage"
     }
    },
    {
     "args": [
      100,
      0,
      0
     ],
     "expect": {
      "Err": "BadPerPage"
     }
    },
    {
     "args": [
      100,
      0,
      -3
     ],
     "expect": {
      "Err": "BadPerPage"
     }
    },
    {
     "args": [
      -5,
      -2,
      0
     ],
     "expect": {
      "Err": "NegativeTotal"
     }
    },
    {
     "args": [
      10,
      9223372036854775807,
      10
     ],
     "expect": {
      "Err": "Overflow"
     }
    },
    {
     "args": [
      9223372036854775807,
      1,
      9223372036854775806
     ],
     "expect": {
      "Err": "Overflow"
     }
    },
    {
     "args": [
      10,
      0,
      10
     ],
     "expect": {
      "Ok": [
       0,
       10,
       false
      ]
     }
    }
   ]
  }
 ]
}