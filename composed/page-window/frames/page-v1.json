{"af1": 1, "afx": 1,
 "types": [{"name": "PageError", "variant": ["NegativeTotal", "NegativePage", "BadPerPage", "Overflow"]}],
 "fns": [{"fn": "page_window", "params": [["total", "i64"], ["page", "i64"], ["per_page", "i64"]],
          "returns": "Result<(i64,i64,bool),PageError>",
          "blocks": [
            {"name": "entry",
             "ops": [["!NegativeTotal", "if", ["lt", "total", 0]],
                     ["!NegativePage", "if", ["lt", "page", 0]],
                     ["!BadPerPage", "if", ["lt", "per_page", 1]],
                     ["start", "mul?Overflow", "page", "per_page"]],
             "term": ["cond", ["ge", "start", "total"], ["past_end"], ["window"]]},
            {"name": "past_end",
             "ops": [["w", "tuple", "total", {"type": "i64", "value": 0}, false]],
             "term": ["ok", "w"]},
            {"name": "window",
             "params": [["start", "i64"]],
             "ops": [["end", "add?Overflow", "start", "per_page"],
                     ["rem", "sub?Overflow", "total", "start"],
                     ["more", "le", "end", "total"]],
             "term": ["cond", ["le", "per_page", "rem"], ["full"], ["part"]]},
            {"name": "full",
             "params": [["start", "i64"]],
             "ops": [["w", "tuple", "start", "per_page", "more"]],
             "term": ["ok", "w"]},
            {"name": "part",
             "params": [["start", "i64"], ["rem", "i64"]],
             "ops": [["w", "tuple", "start", "rem", "more"]],
             "term": ["ok", "w"]}]}],
 "test_tables": [{"name": "page_cases", "fn": "page_window", "cases": [
   {"args": [100, 0, 10], "expect": {"Ok": [0, 10, true]}},
   {"args": [100, 9, 10], "expect": {"Ok": [90, 10, true]}},
   {"args": [95, 9, 10], "expect": {"Ok": [90, 5, false]}},
   {"args": [100, 10, 10], "expect": {"Ok": [100, 0, false]}},
   {"args": [100, 11, 10], "expect": {"Ok": [100, 0, false]}},
   {"args": [0, 0, 10], "expect": {"Ok": [0, 0, false]}},
   {"args": [0, 5, 10], "expect": {"Ok": [0, 0, false]}},
   {"args": [7, 0, 10], "expect": {"Ok": [0, 7, false]}},
   {"args": [-1, 0, 10], "expect": {"Err": "NegativeTotal"}},
   {"args": [100, -1, 10], "expect": {"Err": "NegativePage"}},
   {"args": [100, 0, 0], "expect": {"Err": "BadPerPage"}},
   {"args": [100, 0, -3], "expect": {"Err": "BadPerPage"}},
   {"args": [-5, -2, 0], "expect": {"Err": "NegativeTotal"}},
   {"args": [10, 9223372036854775807, 10], "expect": {"Err": "Overflow"}},
   {"args": [9223372036854775807, 1, 9223372036854775806], "expect": {"Err": "Overflow"}}]}]}
