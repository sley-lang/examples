{"af1": 1, "afx": 1, "test_tables": [{"name": "gate_cases", "fn": "cooldown_gate", "cases": [{"args": [2, 5, 100, 90, 30], "expect": {"Ok": ["Closed", 0]}}, {"args": [5, 5, 100, 90, 30], "expect": {"Ok": ["Open", 20]}}, {"args": [5, 5, 95, 90, 30], "expect": {"Ok": ["Open", 25]}}, {"args": [5, 5, 119, 90, 30], "expect": {"Ok": ["Open", 1]}}, {"args": [5, 5, 120, 90, 30], "expect": {"Ok": ["HalfOpen", 0]}}, {"args": [5, 5, 90, 90, 0], "expect": {"Ok": ["HalfOpen", 0]}}, {"args": [3, 3, 50, 50, 10], "expect": {"Ok": ["Open", 10]}}, {"args": [-1, 0, 0, 0, -5], "expect": {"Err": "NegativeFailures"}}, {"args": [0, 0, 5, 0, 0], "expect": {"Err": "BadThreshold"}}, {"args": [1, 1, 0, 0, -1], "expect": {"Err": "BadCooldown"}}, {"args": [5, 5, 80, 90, 30], "expect": {"Err": "BadClock"}}, {"args": [5, 5, 9223372036854775807, -1, 30], "expect": {"Err": "Overflow"}}, {"args": [9, 5, 200, 100, 50], "expect": {"Ok": ["HalfOpen", 0]}}, {"args": [0, 1, 0, 0, 0], "expect": {"Ok": ["Closed", 0]}}, {"args": [7, 7, 1000, 0, 1000], "expect": {"Ok": ["HalfOpen", 0]}}]}]}