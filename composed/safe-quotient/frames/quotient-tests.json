{
 "af1": 1,
 "afx": 1,
 "test_tables": [
  {
   "name": "quotient_cases",
   "fn": "safe_quotient",
   "cases": [
    {
     "args": [
      6,
      3
     ],
     "expect": {
      "Ok": 2
     }
    },
    {
     "args": [
      7,
      2
     ],
     "expect": {
      "Ok": 3
     }
    },
    {
     "args": [
      -7,
      2
     ],
     "expect": {
      "Ok": -3
     }
    },
    {
     "args": [
      7,
      -2
     ],
     "expect": {
      "Ok": -3
     }
    },
    {
     "args": [
      0,
      5
     ],
     "expect": {
      "Ok": 0
     }
    },
    {
     "args": [
      9,
      1
     ],
     "expect": {
      "Ok": 9
     }
    },
    {
     "args": [
      5,
      0
     ],
     "expect": {
      "Err": "DivByZero"
     }
    },
    {
     "args": [
      -9223372036854775808,
      -1
     ],
     "expect": {
      "Err": "Overflow"
     }
    }
   ]
  }
 ]
}